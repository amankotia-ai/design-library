--- before/system-browser.css
+++ after/system-browser.css
@@ -2,7 +2,7 @@
 .library-home .article-header{margin-bottom:96px}
 .system-home{padding-bottom:64px}
 .catalog-heading{display:flex;justify-content:space-between;align-items:baseline;gap:16px;margin-bottom:20px}
-.catalog-heading h1{font-size:18px;font-weight:500;margin:0}
+.catalog-heading h1{font-size:var(--library-catalog-title-size);line-height:var(--library-catalog-title-leading);font-weight:500;margin:0}
 .system-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--library-grid-row-gap) var(--library-gap)}
 .system-card{border:0;border-radius:0;overflow:visible;background:transparent;min-width:0}
 .style-preview{display:flex;aspect-ratio:9/10;padding:var(--library-preview-inset) var(--library-preview-inset) 0;background:var(--library-wash);overflow:hidden;border:1px solid var(--library-rule);border-radius:var(--library-preview-radius)}
@@ -12,13 +12,13 @@
 .system-card-body{padding:var(--library-caption-gap) 0 0}
 .card-meta{display:flex;justify-content:space-between;gap:10px;font-size:10px;color:var(--library-muted)}
 .card-meta>span:last-child{white-space:nowrap}
-.system-card h2{font-size:23px;line-height:1.3;font-weight:500;margin:12px 0 16px}
+.system-card h2{font-size:var(--library-card-title-size);line-height:var(--library-card-title-leading);font-weight:500;margin:var(--library-card-title-before) 0 var(--library-card-title-after)}
 .system-card h2 a:hover,.card-bottom a:hover,.section-inventory a:hover span:first-child{text-decoration:underline}
-.card-palette{display:flex;align-items:center;gap:0;margin-bottom:24px}
+.card-palette{display:flex;align-items:center;gap:0;margin-bottom:var(--library-card-detail-bottom)}
 .card-palette>span:not(.palette-type){flex:none;width:16px;height:16px;border:1px solid #0000001a;border-radius:50%}
 .card-palette>span:not(.palette-type)+span:not(.palette-type){margin-left:-5px}
 .card-palette .palette-type{font-size:10px;color:var(--library-muted);margin-left:12px}
-.card-bottom{display:flex;justify-content:space-between;gap:12px;border-top:1px solid var(--library-rule);padding-top:15px;font-size:11px}
+.card-bottom{display:flex;justify-content:space-between;gap:12px;border-top:1px solid var(--library-rule);padding-top:var(--library-card-footer-top);font-size:11px}
 .card-bottom>span{color:var(--library-muted);font-variant-numeric:tabular-nums}
 .back-to-systems{display:inline-block;font-size:12px;color:var(--library-muted);margin-bottom:32px}
 .system-detail h1{font-size:36px;line-height:1.2;margin-bottom:14px}
